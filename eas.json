{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "node": "22.23.3",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_NPM_CI": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://chakradhar-backend.onrender.com/api"
      },
      "distribution": "internal"
    },
    "production": {
      "node": "22.23.3",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_NO_NPM_CI": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://chakradhar-backend.onrender.com/api"
      }
    }
  },
  "submit": {}
}
