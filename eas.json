{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "node": "18.17.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_NPM_CI": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "production": {
      "node": "18.17.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_NO_NPM_CI": "1",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    }
  },
  "submit": {}
}
